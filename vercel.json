{
  "version": 2,
  "regions": ["sin1"],
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    { "path": "/api/jobs/ats/sync", "schedule": "30 0 * * *" },
    { "path": "/api/jobs/ats/sync", "schedule": "30 4 * * *" },
    { "path": "/api/jobs/ats/sync", "schedule": "30 8 * * *" },
    { "path": "/api/jobs/ats/sync", "schedule": "30 12 * * *" },
    { "path": "/api/jobs/ats/sync", "schedule": "30 16 * * *" },
    { "path": "/api/jobs/ats/sync", "schedule": "30 20 * * *" }
  ]
}
